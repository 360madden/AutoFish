{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autofish.local/contracts/fishing-profile.schema.json",
  "title": "FishingProfile",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "zoneName",
    "targetSkill",
    "enabledSkills",
    "pacing",
    "thresholds",
    "guardrails"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayName": { "type": "string" },
    "zoneName": { "type": "string" },
    "targetSkill": { "type": "string" },
    "enabledSkills": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "baitName": { "type": ["string", "null"] },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pacing": {
      "type": "object",
      "required": ["reactionFloorMs", "reactionCeilingMs", "biteTimeoutMs", "lootTimeoutMs"],
      "properties": {
        "reactionFloorMs": { "type": "integer", "minimum": 0 },
        "reactionCeilingMs": { "type": "integer", "minimum": 0 },
        "biteTimeoutMs": { "type": "integer", "minimum": 0 },
        "lootTimeoutMs": { "type": "integer", "minimum": 0 },
        "interCastDelayMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["rebaitAtOrBelow", "maintenanceAtFreeSlotsOrBelow", "maxRecoveryAttempts"],
      "properties": {
        "rebaitAtOrBelow": { "type": "integer", "minimum": 0 },
        "maintenanceAtFreeSlotsOrBelow": { "type": "integer", "minimum": 0 },
        "maxRecoveryAttempts": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "object",
      "required": ["pauseOnCombat", "pauseOnBridgeLoss", "recoverOnDrift"],
      "properties": {
        "pauseOnCombat": { "type": "boolean" },
        "pauseOnBridgeLoss": { "type": "boolean" },
        "recoverOnDrift": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
